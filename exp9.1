%{
#include "exp9yacc.h"
%}

%%

[0-9]+(\.[0-9]+)?           { return NUM; }       // Matches integers and decimals (e.g., 10, 3.14)
[a-zA-Z_][a-zA-Z0-9_]*      { return ID; }        // Matches variables (e.g., a, b, x1)
[+\-*/()]                   { return yytext[0]; } // Returns operator/bracket ASCII directly to Yacc
\n                          { return '\n'; }      // Signals end of expression
[ \t]+                      ;                     // Ignores spaces and tabs
.                           { return yytext[0]; } // Passes invalid characters to trigger syntax error

%%

int yywrap(void) {
    return 1;
}
